# Copy to .env and fill in. Never commit .env (already gitignored via .env*).
# Used by scripts/ingest.ts (Phase 2.2). These are local-only for now — the
# same keys also need to be set as Cloudflare Worker secrets before Phase 3/4
# (chat/voice) can call them from the deployed app.

# Notion internal integration token (Settings -> Connections -> Develop or manage integrations
# in the workspace, create an "Internal Integration", then share the "Knowledge Base"
# database with it). Starts with "ntn_" or "secret_".
NOTION_TOKEN=

# Google AI Studio API keys (https://aistudio.google.com/apikey) — kept as separate
# keys per service so usage/limits can be managed independently.
GOOGLE_API_KEY_EMB=
GOOGLE_API_KEY_LLM=
GOOGLE_API_KEY_LIVE=

# Chroma Cloud — dedicated API key for this ingestion script (same tenant/database
# as the chroma-mcp server, but its own key).
CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Optional override — defaults to the confirmed "Knowledge Base" data source ID.
NOTION_KNOWLEDGE_BASE_DATA_SOURCE_ID=
