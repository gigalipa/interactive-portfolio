---
import Layout from "../layouts/Layout.astro";
import GlassPanel from "../components/ui/GlassPanel.astro";
import { getDictionary, type Locale } from "../i18n";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Layout
	title={`${t.cv.title} — Daniel Peraza`}
	description={t.meta.description}
	lang={lang}
>
	<main class="flex min-h-screen items-center justify-center px-6 py-24">
		<GlassPanel class="max-w-lg p-8 text-center" glow="blue">
			<p
				class="text-signal-cyan/80 font-mono text-xs tracking-[0.2em] uppercase"
			>
				{t.cv.phase}
			</p>
			<h1 class="font-display text-ion mt-3 text-2xl font-semibold">
				{t.cv.title}
			</h1>
			<p class="font-body text-ion/70 mt-3 text-sm">{t.cv.body}</p>
		</GlassPanel>
	</main>
</Layout>
