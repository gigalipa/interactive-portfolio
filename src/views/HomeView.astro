---
import Layout from "../layouts/Layout.astro";
import PresenceRing from "../components/ui/PresenceRing.astro";
import { ChatWidget } from "../components/chat/ChatWidget";
import { getDictionary, type Locale } from "../i18n";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Layout title={t.home.title} description={t.meta.description} lang={lang}>
	<main
		class="flex min-h-screen flex-col items-center justify-center gap-8 px-6 text-center"
	>
		<PresenceRing state="idle" size={240} />
		<div class="max-w-xl space-y-3">
			<p
				class="text-signal-cyan/80 font-mono text-xs tracking-[0.2em] uppercase"
			>
				{t.home.status}
			</p>
			<h1 class="font-display text-ion text-4xl font-semibold sm:text-5xl">
				Daniel Peraza
			</h1>
			<p class="font-body text-ion/70 text-base sm:text-lg">
				{t.home.tagline}
			</p>
		</div>
		<!-- client:only (not client:load): consent lives in localStorage, so getConsent() always returns null during SSR and the server-rendered consent banner would mismatch the client's hydrated state. -->
		<ChatWidget lang={lang} client:only="react" />
	</main>
</Layout>
