---
import type { LocalizedEntry } from "../../lib/notion/translate";
import type { Locale } from "../../i18n/locales";

interface Props {
	entry: LocalizedEntry;
	chips: string[];
	presentLabel: string;
	viewProjectsLabel: string;
	lang: Locale;
}

const { entry, chips, presentLabel, viewProjectsLabel, lang } = Astro.props;

const dates = entry.metadata.dates;
function formatYear(iso: string): string {
	const year = new Date(iso).getFullYear();
	return Number.isNaN(year) ? iso : String(year);
}

const dateRange = dates?.start
	? `${formatYear(dates.start)} – ${dates.ongoing || !dates.end ? presentLabel : formatYear(dates.end)}`
	: null;

const metaLine = [entry.displayCategory, entry.displayLocation, dateRange].filter(Boolean).join(" · ");

const techStack = entry.metadata.techStack ?? [];
const skillChips = [...new Set(chips)];
const techChips = [...new Set(techStack)].filter((chip) => !skillChips.includes(chip));

const isProject = entry.contentType === "Project";
---

<div class="border-slate-mist bg-deep-blue/30 rounded-xl border p-4">
	<h3 class="font-display text-ion text-base font-semibold">{entry.displayTitle}</h3>
	{metaLine && <p class="text-signal-cyan/70 mt-1 font-mono text-xs">{metaLine}</p>}
	{entry.displayDescription && <p class="font-body text-ion/80 mt-2 text-sm">{entry.displayDescription}</p>}
	{
		skillChips.length > 0 && (
			<div class="mt-3 flex flex-wrap gap-1.5">
				{skillChips.map((chip) => (
					<span class="border-slate-mist-strong text-ion/70 rounded-full border px-2 py-0.5 text-xs">
						{chip}
					</span>
				))}
			</div>
		)
	}
	{
		techChips.length > 0 && (
			<div class="mt-1.5 flex flex-wrap gap-1.5">
				{techChips.map((chip) => (
					<span class="border-slate-mist-strong text-ion/70 rounded-full border px-2 py-0.5 text-xs">
						{chip}
					</span>
				))}
			</div>
		)
	}
	{
		isProject && (
			<a
				href={`/${lang}/portfolio`}
				class="text-signal-cyan mt-3 inline-block text-sm underline hover:text-signal-cyan/80"
			>
				{viewProjectsLabel}
			</a>
		)
	}
</div>
