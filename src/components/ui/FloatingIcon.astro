---
import type { Locale } from "../../i18n";

interface Props {
	src?: string;
	lang: Locale;
	label?: string;
}

const { src, lang, label = "Daniel Peraza — home" } = Astro.props;
const href = `/${lang}/`;
---

{
	src ? (
		<a
			href={href}
			aria-label={label}
			class="fixed top-5 left-5 z-50 h-12 w-12 transition-transform duration-200 hover:scale-105 sm:top-6 sm:left-6"
		>
			<img
				src={src}
				alt={label}
				class="h-full w-full object-contain drop-shadow-[0_0_18px_rgba(47,92,255,0.55)]"
			/>
		</a>
	) : (
		<a
			href={href}
			aria-label={label}
			class="group border-slate-mist bg-deep-blue/50 shadow-glow-blue fixed top-5 left-5 z-50 flex h-12 w-12 items-center justify-center rounded-full border backdrop-blur-xl transition-transform duration-200 hover:scale-105 sm:top-6 sm:left-6"
		>
			<span class="font-display text-ion group-hover:text-electric-blue-soft text-lg font-semibold">
				DP
			</span>
		</a>
	)
}
