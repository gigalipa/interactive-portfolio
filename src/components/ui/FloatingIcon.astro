---
interface Props {
	src?: string;
	href?: string;
	label?: string;
}

const { src, href = "/", label = "Daniel Peraza — home" } = Astro.props;
---

<a
	href={href}
	aria-label={label}
	class="group border-slate-mist bg-deep-blue/50 shadow-glow-blue fixed top-5 left-5 z-50 flex h-12 w-12 items-center justify-center rounded-full border backdrop-blur-xl transition-transform duration-200 hover:scale-105 sm:top-6 sm:left-6"
>
	{
		src ? (
			<img src={src} alt={label} class="h-7 w-7 object-contain" />
		) : (
			<span class="font-display text-ion group-hover:text-electric-blue-soft text-lg font-semibold">
				DP
			</span>
		)
	}
</a>
