---
import Layout from "../layouts/Layout.astro";
import GlassPanel from "../components/ui/GlassPanel.astro";
import GlowButton from "../components/ui/GlowButton.astro";
---

<Layout title="Contact — Daniel Peraza">
	<main class="flex min-h-screen items-center justify-center px-6 py-24">
		<GlassPanel class="max-w-lg space-y-4 p-8 text-center" glow="cyan">
			<p
				class="text-signal-cyan/80 font-mono text-xs tracking-[0.2em] uppercase"
			>
				Phase 7
			</p>
			<h1 class="font-display text-ion mt-3 text-2xl font-semibold">Contact</h1>
			<p class="font-body text-ion/70 mt-3 text-sm">
				A contact form and Notion-backed meeting booking land here.
			</p>
			<GlowButton variant="cyan" href="mailto:hello@example.com"
				>Say hello</GlowButton
			>
		</GlassPanel>
	</main>
</Layout>
