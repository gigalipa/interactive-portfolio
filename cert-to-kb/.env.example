# cert-to-kb MCP Server Configuration

# Auth token to avoid unwanted connections (This is user generated)
# Can be generated at https://www.lastpass.com/es/features/password-generator
MCP_AUTH_TOKEN=<your_authorization_token_here>

# Notion API Token (required)
# Generate at: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_token

# Notion Knowledge Base Database ID (required) — the plain database UUID, NOT a data
# source ID and NOT prefixed with "collection://". @notionhq/client v2.x (used here)
# predates Notion's multi-data-source database model, so it needs the database_id itself.
# Find it in the database URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=5ddd97f8-4124-4581-9fbe-8eef41d10d71

# Folder containing PDF certificates (required)
# For local development: Use C:/Users/peraz/Projects/Misc/interactive-portfolio/docs/certificates
# For Docker: Use /app/certs (mounted volume)
CERTIFICATES_FOLDER=C:/Users/peraz/Projects/Misc/interactive-portfolio/docs/certificates

# MCP Server Configuration (optional)
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3000

# Rate limiting (optional)
MAX_CONCURRENT_PROCESSING=5
REQUEST_DELAY_MS=1000
