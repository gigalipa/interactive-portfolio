{
  "name": "cert-to-kb",
  "version": "1.0.0",
  "description": "MCP Server for processing PDF certificates into Notion Knowledge Base",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run"
  },
  "keywords": ["mcp", "notion", "pdf", "certificates", "knowledge-base"],
  "author": "Daniel Peraza",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@notionhq/client": "^2.2.10",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  }
}
